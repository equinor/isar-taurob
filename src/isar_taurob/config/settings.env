# List of supported tasks for the robot, used to determine if the robot is capable
# of performing a mission in ISAR.
CAPABILITIES = '
["take_image", "take_thermal_image", "take_video", "take_thermal_video", "record_audio", "take_acoustic_measurement", "take_xam8000_gas_measurement"]
'
ROBOT_MODEL = TaurobInspector
VALID_ARM_POSES = '["transport","battery_change","lookout"]'

TAUROB_ASSET_SHORT_NAME = default
TAUROB_ROBOT_NAME = default

TAUROB_ROBOT_REQUESTS_TIMEOUT = 60
TAUROB_MAX_RETRIES_POSE_TELEMETRY = 10

TAUROB_SENSOR_REFRESH_INTERVAL = 3
TAUROB_ACOUSTIC_SENSITIVITY = high
