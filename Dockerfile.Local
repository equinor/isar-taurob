FROM ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 AS uv
FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928 AS build

COPY --from=uv /uv /uvx /bin/
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config libcairo2-dev libgirepository-2.0-dev \
    && rm -rf /var/lib/apt/lists/*

# Supply ISAR with --build-context isar_source=/path/to/isar.
# Omit Git metadata so submodules and worktrees work like standalone checkouts.
COPY pyproject.toml README.md ./
COPY src/isar_taurob ./src/isar_taurob
COPY --from=isar_source pyproject.toml README.md LICENSE /src/isar/
COPY --from=isar_source src /src/isar/src
RUN uv venv /app/.venv
RUN printf 'isar @ file:///src/isar\n' > /app/isar-override.txt && \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_ISAR=0.0.0+local \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_ISAR_TAUROB=0.0.0+local \
    uv pip install --python /app/.venv/bin/python --override /app/isar-override.txt /src/isar ".[recording]"

FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg socat libcairo2 libgirepository-2.0-0 gir1.2-gst-plugins-bad-1.0 \
    gstreamer1.0-nice gstreamer1.0-plugins-good gstreamer1.0-plugins-bad \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --uid 1000 --shell /bin/bash app \
    && mkdir -p /data && chown 1000:1000 /data
COPY --from=build --chown=1000:1000 /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" IS_DOCKER=true ISAR_ROBOT_PACKAGE=isar_taurob
WORKDIR /data
EXPOSE 3000
USER 1000
CMD ["isar-start"]
